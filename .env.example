# Google Gemini API Key 
GEMINI_API_KEY=your_gemini_api_key_here

# Nama model Gemini (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Temperature kreativitas jawaban (default: 0.75)
GEMINI_TEMPERATURE=0.75

# Port server (default: 3000)
PORT=3000

# Environment mode (development / production)
NODE_ENV=development

# Konfigurasi Rate Limit pada /api/chat
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Batas maksimal total request per hari per instance server (default: 500)
DAILY_REQUEST_CAP=500

# Batas maksimal request per hari per alamat IP per instance server (default: 60)
DAILY_REQUEST_CAP_PER_IP=60

# Path kustom executable Chrome atau Chromium (opsional, hanya dipakai skrip test:layout dan test:behavior)
# CHROME_PATH=
