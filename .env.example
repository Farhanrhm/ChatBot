# Google Gemini API Key (format tunggal legacy)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini API Key Pooling (opsional: pisahkan dengan koma untuk multi-key)
GEMINI_API_KEYS=DUMMY1,DUMMY2,DUMMY3

# Sentry Error Tracking (opsional)
SENTRY_DSN=https____
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Nama model Gemini utama (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Model cadangan otomatis saat model utama menghadapi lonjakan 503/429 (default: gemini-3-flash-preview)
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Temperature kreativitas jawaban (default: 0.75)
GEMINI_TEMPERATURE=0.75

# Port server (default: 3000)
PORT=3000

# Environment mode (development / production)
NODE_ENV=development

# Konfigurasi Rate Limit pada /api/chat
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Batas maksimal total request per hari per instance server (default: 500)
DAILY_REQUEST_CAP=500

# Batas maksimal request per hari per alamat IP per instance server (default: 60)
DAILY_REQUEST_CAP_PER_IP=60

# Path kustom executable Chrome atau Chromium (opsional, hanya dipakai skrip test:layout dan test:behavior)
# CHROME_PATH=

# Konfigurasi Upstash Redis / Vercel KV (opsional, untuk pelacakan kuota harian & cache terdistribusi serverless)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

